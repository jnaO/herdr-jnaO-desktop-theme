#!/usr/bin/env bash
# Re-merges the theme onto a new Herdr release.
#   tools/sync [--dry-run] [--theirs <home>]
# Compares the shipped sources' installed.json hashes with upstream/manifest.json
# and exits 0 silently when nothing the theme was cloned from changed. Otherwise
# it builds a staging copy of every theme mod and the layout: a 3-way merge of
# base (upstream/), ours (the live clone) and theirs (the newly shipped source),
# then tools/radius, a cloned_from.version bump and herdr-app check. The live
# Herdr home is only read. --theirs reads the shipped sources from another home
# (a rehearsal copy) instead of the live one.
# Without --dry-run, a clean and checked result goes live: the live theme is
# backed up, the staged mods and layout are swapped in and checked again (the
# backup comes back if that fails), then upstream/ is advanced, tools/export
# runs and a local commit is made. It never pushes. Every outcome other than
# "nothing changed" is posted as a macOS notification and logged to sync.log.
# HERDR_SYNC_REHEARSE_FAILURE=1 fails the live check on purpose (rehearsals).
# Exit: 0 unchanged, or applied (or, with --dry-run, clean and checked);
#       1 conflicts, failed checks or a rolled-back apply.
set -eu
. "$(dirname "$0")/lib.sh"
need jq; need git; need rsync; need herdr-app

dry_run=0
theirs_home="$HERDR_HOME"
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry_run=1 ;;
    --theirs) theirs_home=${2:?--theirs needs a folder}; shift ;;
    *) die "usage: tools/sync [--dry-run] [--theirs <home>]" ;;
  esac
  shift
done

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/herdr-jnaO-desktop-theme"
manifest="$REPO_ROOT/upstream/manifest.json"
[ -f "$manifest" ] || die "no upstream/manifest.json; run tools/snapshot-upstream first"
mkdir -p "$STATE_DIR"
log_file="$STATE_DIR/sync.log"

# One run at a time; a second run while one is going does nothing.
lock="$STATE_DIR/lock"
mkdir "$lock" 2>/dev/null || exit 0
trap 'rmdir "$lock" 2>/dev/null || true' EXIT

# Outcome: a log line and, where possible, a macOS notification.
announce() { # <outcome> <message>
  echo "$(date '+%Y-%m-%d %H:%M:%S') $1 Herdr ${new_version:-?}: $2" >> "$log_file"
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"$2 Log: ${log_file/#$HOME/~}\" with title \"jnaO theme sync: $1\"" >/dev/null 2>&1 || true
  fi
}

# Herdr writes its files over a moment when it starts or updates: wait until
# installed.json and the shipped mods have been still for 5 seconds.
newest_mtime() {
  find "$@" -type f -exec stat -f %m {} + 2>/dev/null || find "$@" -type f -exec stat -c %Y {} + 2>/dev/null
}
for _ in $(seq 1 60); do
  latest=$(newest_mtime "$theirs_home/installed.json" "$theirs_home/mods" | sort -n | tail -1)
  [ $(( $(date +%s) - ${latest:-0} )) -ge 5 ] && break
  sleep 1
done

# --- Did anything the theme was cloned from change? ---------------------------
current=$(jq -S --argjson keys "$(jq '.hashes | keys' "$manifest")" \
  '. as $all | reduce $keys[] as $k ({}; .[$k] = $all[$k])' "$theirs_home/installed.json")
[ "$current" = "$(jq -S .hashes "$manifest")" ] && exit 0

new_version=$(jq -r '.last_run // empty' "$theirs_home/update-notes.json")
[ -n "$new_version" ] || die "no Herdr version in $theirs_home/update-notes.json"

stage="$STATE_DIR/staging"
rm -rf "$stage"
mkdir -p "$stage/base" "$stage/theirs" "$stage/mods" "$stage/layouts"
report="$stage/report.txt"
: > "$report"
note() { echo "$*" | tee -a "$report"; }
conflicts=0
failures=0

is_json() { case "$1" in *.json) return 0 ;; *) return 1 ;; esac; }

# Herdr's clone rename, applied to a copy of a shipped mod so it lines up with
# the clone: its own asset paths and its self-opening overlay name.
rename_mod() { # <dir> <src> <clone>
  local f
  find "$1" -type f \( -name '*.js' -o -name '*.json' \) | while read -r f; do
    sed -E -e "s#mods/$2/#mods/$3/#g" -e "s#mod: \"$2\"#mod: \"$3\"#g" "$f" > "$f.ren" && mv "$f.ren" "$f"
  done
}

# JSON is merged with sorted keys: Herdr reorders keys when it clones.
normalise() { # <file> -> stdout
  if is_json "$1"; then jq -S . "$1"; else cat "$1"; fi
}

# One file, three sides; any side may be missing. Writes the result to <out>.
merge_file() { # <rel> <base> <ours> <theirs> <out> <label>
  local rel=$1 b=$2 o=$3 t=$4 out=$5 label=$6 tmp="$stage/.tmp"
  mkdir -p "$tmp" "$(dirname "$out")"
  for side in b o t; do
    eval "p=\$$side"
    if [ -f "$p" ]; then normalise "$p" > "$tmp/$side"; else rm -f "$tmp/$side"; fi
  done
  if [ ! -f "$tmp/o" ]; then
    # Not in the clone: new upstream files arrive; files the clone deleted stay deleted.
    [ -f "$tmp/t" ] && [ ! -f "$tmp/b" ] && cp "$t" "$out" && note "  added upstream: $label/$rel"
    return 0
  fi
  if [ ! -f "$tmp/t" ]; then
    if [ ! -f "$tmp/b" ]; then cp "$o" "$out"                              # the clone's own file
    elif cmp -s "$tmp/o" "$tmp/b"; then note "  removed upstream: $label/$rel"
    else cp "$o" "$out"; conflicts=$((conflicts + 1)); note "  CONFLICT $label/$rel: removed upstream, changed in the clone"
    fi
    return 0
  fi
  [ -f "$tmp/b" ] || : > "$tmp/b"
  # Unchanged sides copy the original file; only real merges come out normalised.
  if cmp -s "$tmp/t" "$tmp/b" || cmp -s "$tmp/o" "$tmp/t"; then cp "$o" "$out"; return 0; fi
  if cmp -s "$tmp/o" "$tmp/b"; then cp "$t" "$out"; return 0; fi
  if git merge-file -p -L "$label (theme)" -L "Herdr $(jq -r .version "$manifest")" -L "Herdr $new_version" \
       "$tmp/o" "$tmp/b" "$tmp/t" > "$out"; then
    note "  merged: $label/$rel"
  else
    conflicts=$((conflicts + 1)); note "  CONFLICT $label/$rel"
  fi
}

merge_tree() { # <base dir> <ours dir> <theirs dir> <out dir> <label>
  local rel
  { (cd "$1" 2>/dev/null && find . -type f) ; (cd "$2" && find . -type f) ; (cd "$3" 2>/dev/null && find . -type f) ; } \
    | grep -vE '\.d\.ts$|/jsconfig\.json$|/\.DS_Store$' | sed 's#^\./##' | sort -u | while read -r rel; do
      merge_file "$rel" "$1/$rel" "$2/$rel" "$3/$rel" "$4/$rel" "$5"
      echo "$conflicts" > "$stage/.tmp/conflicts"
    done
  [ -f "$stage/.tmp/conflicts" ] && conflicts=$(cat "$stage/.tmp/conflicts")
}

bump_version() { # <json file>
  jq --arg v "$new_version" '.cloned_from.version = $v' "$1" > "$1.v" && mv "$1.v" "$1"
}

note "Herdr $(jq -r .version "$manifest") -> $new_version"
mods=$(theme_mods "$HERDR_HOME")

# --- Mods ---------------------------------------------------------------------
for m in $mods; do
  src=$(cloned_from "$HERDR_HOME/mods/$m/mod.json" name)
  note "$m (from $src)"
  for side in base theirs; do
    from="$REPO_ROOT/upstream/mods/$src"; [ "$side" = theirs ] && from="$theirs_home/mods/$src"
    if [ -d "$from" ]; then
      rsync -a "${RSYNC_EXCLUDES[@]}" "$from/" "$stage/$side/$m/"
      rename_mod "$stage/$side/$m" "$src" "$m"
      # Corners on every side, so a radius-only difference never conflicts.
      "$REPO_ROOT/tools/radius" "$stage/$side/$m" > /dev/null
    fi
  done
  [ -d "$theirs_home/mods/$src" ] || note "  WARNING: Herdr no longer ships '$src'; keeping the clone as it is"
  merge_tree "$stage/base/$m" "$HERDR_HOME/mods/$m" "$stage/theirs/$m" "$stage/mods/$m" "$m"
  "$REPO_ROOT/tools/radius" "$stage/mods/$m" > /dev/null
  bump_version "$stage/mods/$m/mod.json"
  # New upstream openers of Herdr's framed menus (the theme routes its own to jnao-menu).
  grep -hE 'openOverlay\(\{ *mod: "(menu|new-menu)"' "$stage/theirs/$m"/*.js 2>/dev/null | while read -r line; do
    grep -qF "$line" "$stage/base/$m"/*.js 2>/dev/null || note "  WARNING: new upstream menu opener: $(echo "$line" | cut -c1-120)"
  done
done

# --- Layout -------------------------------------------------------------------
layout_src=$(cloned_from "$HERDR_HOME/layouts/$THEME_LAYOUT.json" name)
note "layouts/$THEME_LAYOUT.json (from $layout_src)"
map_mods() { # <layout file>: point mod refs at their clones
  local f=$1 m src
  for m in $mods; do
    src=$(cloned_from "$HERDR_HOME/mods/$m/mod.json" name)
    sed -E "s#\"mod\": *\"$src\"#\"mod\": \"$m\"#g" "$f" > "$f.map" && mv "$f.map" "$f"
  done
}
cp "$REPO_ROOT/upstream/layouts/$layout_src.json" "$stage/base/layout.json"
cp "$theirs_home/layouts/$layout_src.json" "$stage/theirs/layout.json"
map_mods "$stage/base/layout.json"; map_mods "$stage/theirs/layout.json"
merge_file "$THEME_LAYOUT.json" "$stage/base/layout.json" "$HERDR_HOME/layouts/$THEME_LAYOUT.json" \
  "$stage/theirs/layout.json" "$stage/layouts/$THEME_LAYOUT.json" "layouts"
[ -s "$stage/layouts/$THEME_LAYOUT.json" ] && jq -e . "$stage/layouts/$THEME_LAYOUT.json" > /dev/null 2>&1 \
  && bump_version "$stage/layouts/$THEME_LAYOUT.json"

# --- Check --------------------------------------------------------------------
if [ "$conflicts" -eq 0 ]; then
  for m in $mods; do
    if ! out=$(herdr-app check "$stage/mods/$m" 2>&1); then
      failures=$((failures + 1)); note "CHECK FAILED $m: $(echo "$out" | head -3 | tr '\n' ' ')"
    fi
  done
fi
rm -rf "$stage/.tmp"

note "result: $conflicts conflict(s), $failures failed check(s); staging: ${stage/#$HOME/~}"
if [ "$dry_run" = 1 ]; then [ "$conflicts" -eq 0 ] && [ "$failures" -eq 0 ]; exit; fi

if [ "$conflicts" -gt 0 ]; then
  announce conflict "$conflicts file(s) conflict; the live theme is unchanged. See ${report/#$HOME/~}."
  exit 1
fi
if [ "$failures" -gt 0 ]; then
  announce "check failed" "$failures staged mod(s) failed herdr-app check; the live theme is unchanged. See ${report/#$HOME/~}."
  exit 1
fi
if [ -n "$(git -C "$REPO_ROOT" status --porcelain)" ]; then
  announce blocked "the repo has uncommitted changes; commit or stash them, then run tools/sync."
  exit 1
fi

# --- Apply --------------------------------------------------------------------
backup="$STATE_DIR/backups/$(date +%Y%m%d-%H%M%S)"
mkdir -p "$backup/mods" "$backup/layouts"
for m in $mods; do cp -Rp "$HERDR_HOME/mods/$m" "$backup/mods/"; done
cp -p "$HERDR_HOME/layouts/$THEME_LAYOUT.json" "$backup/layouts/"
ls -1d "$STATE_DIR/backups"/*/ | sort -r | tail -n +6 | while read -r old; do rm -rf "$old"; done

restore() {
  local m
  for m in $mods; do
    rm -rf "$HERDR_HOME/mods/$m"
    cp -Rp "$backup/mods/$m" "$HERDR_HOME/mods/"
  done
  cp -p "$backup/layouts/$THEME_LAYOUT.json" "$HERDR_HOME/layouts/"
}

mkdir -p "$stage/replaced"
for m in $mods; do
  # Herdr's generated editor files move across, so editors keep their types.
  for g in "$HERDR_HOME/mods/$m"/*.d.ts "$HERDR_HOME/mods/$m/jsconfig.json"; do
    [ -f "$g" ] && cp -p "$g" "$stage/mods/$m/"
  done
  mv "$HERDR_HOME/mods/$m" "$stage/replaced/$m"
  mv "$stage/mods/$m" "$HERDR_HOME/mods/$m"
done
cp "$stage/layouts/$THEME_LAYOUT.json" "$HERDR_HOME/layouts/$THEME_LAYOUT.json"

live_ok=1
for m in $mods; do
  if ! out=$(herdr-app check "$HERDR_HOME/mods/$m" 2>&1); then
    live_ok=0; note "LIVE CHECK FAILED $m: $(echo "$out" | head -3 | tr '\n' ' ')"
  fi
done
sleep 2 # hot reload
if status=$(herdr-app status 2>/dev/null); then
  errors=$(echo "$status" | jq -r '.errors | length' 2>/dev/null || echo 0)
  [ "${errors:-0}" = 0 ] || { live_ok=0; note "herdr-app status reports errors: $(echo "$status" | jq -c .errors)"; }
fi
[ "${HERDR_SYNC_REHEARSE_FAILURE:-}" = 1 ] && { live_ok=0; note "rehearsed failure"; }

if [ "$live_ok" = 0 ]; then
  restore
  announce "rolled back" "the merged theme failed after going live; the previous theme is restored from ${backup/#$HOME/~}."
  exit 1
fi

"$REPO_ROOT/tools/snapshot-upstream" --from "$theirs_home" > /dev/null
"$REPO_ROOT/tools/export" > /dev/null
git -C "$REPO_ROOT" add -A
git -C "$REPO_ROOT" commit -q -m "Sync theme onto Herdr $new_version"
announce applied "the theme now runs on Herdr $new_version; commit ready to push."
